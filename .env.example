# ============================================================
# M.A.R.S. — Multi-Agent Reasoning System
# Environment Variables (.env)
# ============================================================

# Cloudflare Workers AI (Node 1: Gating Router, Node 3: 1st Principles, Node 6: Executor)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Groq (Node 2: The Contrarian, Node 4: The Expansionist, Node 9: The Validator)
GROQ_API_KEY=gsk_your_groq_api_key

# Mistral AI (Node 5: The Outsider, Node 8 Fallback)
MISTRAL_API_KEY=your_mistral_api_key

# Google AI Studio / Gemini (Node 7: The Chairman, Node 8 / Fallbacks)
GEMINI_API_KEY=your_gemini_api_key

# OpenRouter (Optional: Node 8: The Negativist / Universal Free Fallback Pool)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
