# ============================================================
# MARS — Multi-Agent Reasoning System
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# .env is already in .gitignore — your secrets stay local.
# ============================================================

# ----------------------------------------------------------
# Cloudflare Workers AI (Node 1: Gating Router)
# Get your Account ID: https://dash.cloudflare.com (sidebar)
# Create API Token:    https://dash.cloudflare.com/profile/api-tokens
#   → Create Token → Workers AI: Read permission
# ----------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ----------------------------------------------------------
# Groq (Node 2: The Contrarian, Node 9: The Validator)
# Get API Key: https://console.groq.com/keys
# Free tier: 30 RPM, 14,400 RPD (8B), 1,000 RPD (70B)
# ----------------------------------------------------------
GROQ_API_KEY=

# ----------------------------------------------------------
# NVIDIA NIM (Node 3: First Principle Thinker,
#             Node 6: The Executor, Node 8: The Negativist)
# Sign up:    https://build.nvidia.com
# Get API Key: Profile → API Keys
# Free tier: ~40 RPM, no credit card required
# ----------------------------------------------------------
NVIDIA_API_KEY=

# ----------------------------------------------------------
# OpenRouter (Node 4: The Expansionist)
# Get API Key: https://openrouter.ai/keys
# Free tier: 20 RPM, 50 RPD (or 1,000 RPD with $10+ lifetime credits)
# ----------------------------------------------------------
OPENROUTER_API_KEY=

# ----------------------------------------------------------
# Mistral AI (Node 5: The Outsider)
# Get API Key: https://console.mistral.ai/api-keys
# IMPORTANT:   Activate the "Experiment" plan in Billing first!
# Free tier: 30 RPM, 1 RPS
# ----------------------------------------------------------
MISTRAL_API_KEY=

# ----------------------------------------------------------
# Google AI Studio / Gemini (Node 7: The Chairman)
# Get API Key: https://aistudio.google.com/apikey
# Free tier: ~15 RPM (varies by model)
# ----------------------------------------------------------
GEMINI_API_KEY=
